<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo conexiones cifradas (HTTPS) y solo con los certificados del sistema.
    La app únicamente se conecta a GitHub para buscar actualizaciones.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
